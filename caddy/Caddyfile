# OntoForge — Caddy Auth Gateway
#
# Caddy does NOT terminate TLS. It speaks plain HTTP on :80 and expects a
# TLS-terminating layer in front of it (a Kubernetes Ingress in production;
# nothing in the local compose setup). That layer must pass the request's
# original Host header through unchanged: Caddy picks the facade by hostname.
#
#   http://{$FRONTEND_HOST}  HTTP Basic Auth  ->  /        -> ontoforge-ui:80
#                                              /api/*   -> ontoforge-server:8000
#                                              /mcp/*   -> 404 (never published here)
#   http://{$API_HOST}       Bearer token     ->  /*       -> ontoforge-server:8000
#   :80 any other Host       ->  404
#   :8080 (internal)         ->  /healthz -> 200, no auth (probes)
#
# Every {$VAR} is read from the container environment at start. Secrets
# (BASIC_AUTH_HASH, ONTOFORGE_API_TOKEN) come from a Kubernetes Secret or the
# local .env — never from this file.

{
	# No certificates, no redirects: TLS is someone else's job.
	auto_https off
	# Trust X-Forwarded-* headers from the layer in front (private cluster
	# and Docker addresses), so the original scheme and client IP survive.
	servers {
		trusted_proxies static private_ranges
	}
	# No runtime reconfiguration.
	admin off
}

# Headers the UI never needs from the backend, and that would make a
# Basic-Auth-protected origin CORS-open with credentials. The UI is
# same-origin behind this gateway, so CORS is not required at all.
(strip_cors) {
	header_down -Access-Control-Allow-Origin
	header_down -Access-Control-Allow-Credentials
}

# ===========================================================================
# 1. Frontend facade — HTTP Basic Auth
# ===========================================================================
http://{$FRONTEND_HOST:ontoforge.example.com} {
	log {
		output stdout
		format console
	}

	# The browser shows its native login dialog; after that it re-sends the
	# credentials on every request to this host, including the SPA's
	# relative /api/... calls. The password is stored as a bcrypt hash only.
	basic_auth * bcrypt "OntoForge" {
		{$BASIC_AUTH_USER:admin} {$BASIC_AUTH_HASH}
	}

	# The UI image's nginx would happily forward /mcp/ to the server, so the
	# gateway has to refuse it explicitly before the catch-all below.
	handle /mcp/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy {$SERVER_UPSTREAM:ontoforge-server:8000} {
			# The backend has no auth; do not leak the browser's credentials.
			header_up -Authorization
			import strip_cors
		}
	}

	handle {
		reverse_proxy {$UI_UPSTREAM:ontoforge-ui:80} {
			header_up -Authorization
		}
	}
}

# ===========================================================================
# 2. Backend facade — static Bearer token
# ===========================================================================
http://{$API_HOST:api.ontoforge.example.com} {
	log {
		output stdout
		format console
	}

	# Exact match on the whole header value. The token is injected from the
	# environment; compose / the K8s Deployment refuse to start without it.
	@authorized header Authorization "Bearer {$ONTOFORGE_API_TOKEN}"

	handle @authorized {
		reverse_proxy {$SERVER_UPSTREAM:ontoforge-server:8000} {
			header_up -Authorization
		}
	}

	# Everything else: 401 with the challenge, nothing is proxied.
	handle {
		header WWW-Authenticate `Bearer realm="OntoForge API"`
		respond 401
	}
}

# ===========================================================================
# 3. Any other Host header — refuse. Makes a missing Host pass-through in
#    the layer in front visible immediately instead of silently misrouting.
# ===========================================================================
http:// {
	respond 404
}

# ===========================================================================
# 4. Internal health listener — not published, for readiness/liveness probes
# ===========================================================================
:8080 {
	respond /healthz 200
	respond 404
}
