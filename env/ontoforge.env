# OntoForge server settings — optional features only.
#
# This file is committed and works as-is: semantic search and AI are off.
# Enable a feature by uncommenting its block. Put API keys and other private
# values into env/ontoforge.local.env (git-ignored, read after this file, same
# keys win). Database wiring and PUBLIC_URL are fixed in docker-compose.yml
# and cannot be changed from here.
#
# Full reference: the OntoForge README, sections "Optional Features".

# --- Semantic search (embeddings) -----------------------------------------
# Unset EMBEDDING_PROVIDER = semantic search unavailable.
# Ollama on the host machine:
#EMBEDDING_PROVIDER=ollama
#EMBEDDING_MODEL=nomic-embed-text
#EMBEDDING_BASE_URL=http://host.docker.internal:11434
# OpenAI-compatible API (key belongs in env/ontoforge.local.env):
#EMBEDDING_PROVIDER=openai
#EMBEDDING_MODEL=text-embedding-3-small
#EMBEDDING_BASE_URL=https://api.openai.com
#EMBEDDING_API_KEY=
#EMBEDDING_DIMENSIONS=1536

# --- Documents -------------------------------------------------------------
#DOCUMENT_CHUNK_SIZE=1500
#DOCUMENT_CHUNK_OVERLAP=200

# --- AI features (natural language query, extraction, chat) ---------------
# Unset AI_PROVIDER = AI features unavailable. The model must support tool calling.
# Ollama on the host machine:
#AI_PROVIDER=ollama
#AI_MODEL=qwen3:8b
#AI_BASE_URL=http://host.docker.internal:11434
# OpenAI-compatible API, e.g. OpenRouter (AI_BASE_URL stops before /v1):
#AI_PROVIDER=openai
#AI_BASE_URL=https://openrouter.ai/api
#AI_MODEL=openai/gpt-5.6-luna
#AI_API_KEY=
# How hard the model thinks: none, low, medium, high (unset = model default).
#AI_REASONING_EFFORT=low

# PUBLIC_URL (address advertised in agent cards) is not set here: it is the
# API facade host and is wired by docker-compose.yml / k8s/ontoforge-server.yaml.
