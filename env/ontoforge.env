# OntoForge server settings — optional features only.
#
# This file is committed and works as-is: semantic search and AI are off.
# Enable a feature by uncommenting its block. Put API keys and other private
# values into env/ontoforge.local.env (git-ignored, read after this file, same
# keys win). Database wiring and PUBLIC_URL are fixed in docker-compose.yml
# and cannot be changed from here.
#
# Base URLs are written as the provider documents them: the host for Ollama
# and Anthropic, the API base including its version (…/v1) for an
# OpenAI-compatible API. A base URL in the wrong form stops the server at
# startup.
#
# Full reference: the OntoForge README, sections "Optional Features".

# --- Semantic search (embeddings) -----------------------------------------
# Unset EMBEDDING_PROVIDER = semantic search unavailable.
# Ollama on the host machine:
#EMBEDDING_PROVIDER=ollama
#EMBEDDING_MODEL=nomic-embed-text
#EMBEDDING_BASE_URL=http://host.docker.internal:11434
# OpenAI-compatible API (key belongs in env/ontoforge.local.env):
#EMBEDDING_PROVIDER=openai
#EMBEDDING_MODEL=text-embedding-3-small
#EMBEDDING_BASE_URL=https://api.openai.com/v1
#EMBEDDING_API_KEY=
#EMBEDDING_DIMENSIONS=1536
# Texts per request and requests in flight when many texts are embedded
# together. A cloud endpoint typically takes 16 or more per request.
#EMBEDDING_BATCH_SIZE=1
#EMBEDDING_CONCURRENCY=1

# --- Documents -------------------------------------------------------------
#DOCUMENT_CHUNK_SIZE=1500
#DOCUMENT_CHUNK_OVERLAP=200

# --- AI features (natural language query, chat) ---------------------------
# Unset AI_PROVIDER = AI features unavailable. AI_MODEL is required with a
# provider, and the model must support tool calling.
# Ollama on the host machine:
#AI_PROVIDER=ollama
#AI_MODEL=qwen3:8b
#AI_BASE_URL=http://host.docker.internal:11434
# OpenAI-compatible API, e.g. OpenRouter (key belongs in env/ontoforge.local.env):
#AI_PROVIDER=openai
#AI_BASE_URL=https://openrouter.ai/api/v1
#AI_MODEL=openai/gpt-6-luna
#AI_API_KEY=
# Anthropic (AI_BASE_URL defaults to https://api.anthropic.com):
#AI_PROVIDER=anthropic
#AI_MODEL=claude-haiku-5-5
#AI_API_KEY=
# How hard the model thinks: none, low, medium, high (unset = model default).
#AI_REASONING_EFFORT=low

# PUBLIC_URL (address advertised in agent cards) is not set here: it is the
# API facade host and is wired by docker-compose.yml / k8s/ontoforge-server.yaml.
