# Compose stack configuration. Copy to .env — it works unchanged for local testing.
# .env is git-ignored. OntoForge feature settings (AI, embeddings) live in env/, not here.

# --- OntoForge images: ghcr.io/rawe/ontoforge-server and ghcr.io/rawe/ontoforge-ui
VERSION=latest
POSTGRES_PASSWORD=changeme

# --- Public hosts served by Caddy (scheme included).
# Browsers resolve *.localhost to 127.0.0.1 by themselves.
FRONTEND_HOST=https://ontoforge.localhost
API_HOST=https://api.ontoforge.localhost

# --- TLS mode: internal (Caddy's local CA) | acme (public certificate) | off (TLS terminated in front of Caddy)
CADDY_TLS_MODE=internal
ACME_EMAIL=admin@example.com

# --- Frontend facade: HTTP Basic Auth. Only the bcrypt hash is stored.
# LOCAL TESTING DEFAULT: user "admin", password "ontoforge".
# Replace before any real deployment: scripts/hash-password.sh
# ($$ is docker compose's escape for a literal $ — the script prints it that way)
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=$$2a$$14$$u.x..YRnmOnsd/c8cYCyV.L97Yk7ztHT5yPD8NIvBC.Dhnf6DbdjC

# --- API facade: static Bearer token.
# LOCAL TESTING DEFAULT. Replace before any real deployment: scripts/gen-token.sh
ONTOFORGE_API_TOKEN=local-testing-token-replace-me
